{
  "name": "im-mobile-renderer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env PORT=3002 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && npx wrangler pages dev",
    "deploy": "npm run pages:build && npx wrangler pages deploy",
    "pages:deploy": "npx wrangler pages deploy",
    "build:docker": "docker build -t im-mobile-renderer:latest ."
  },
  "dependencies": {
    "@babel/standalone": "^7.25.3",
    "@capp/immotors-ui": "2.9.1-rc.8",
    "less": "^4.2.0",
    "next": "14.2.6",
    "path-browserify": "^1.0.1",
    "react": "^18",
    "react-dom": "^18",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.2",
    "@types/babel__standalone": "^7.1.7",
    "@types/node": "^20",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cross-env": "^7.0.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
